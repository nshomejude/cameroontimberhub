APP_NAME="Cameroon Timber Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cameroontimberhub
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ops/on-call mailbox for automated reports (daily error digest). Falls back to MAIL_FROM_ADDRESS.
MAIL_OPS_ADDRESS=

# Public contact details rendered on /contact and in ContactPage JSON-LD.
# Defaults live in config/contact.php; set these to override without a deploy.
CONTACT_ADDRESS_LINE1="Bonamoussadi, Douala"
CONTACT_ADDRESS_LINE2="Littoral Region, Cameroon"
CONTACT_ADDRESS_LINE3=
CONTACT_PHONE_1="+237 6 70 41 62 38"
CONTACT_PHONE_2=
CONTACT_WHATSAPP="+237 6 70 41 62 38"
CONTACT_EMAIL_GENERAL="info@cameroontimberhub.com"
CONTACT_EMAIL_PARTNERSHIPS="partnerships@cameroontimberhub.com"
CONTACT_WEBSITE="www.cameroontimberhub.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
PENNANT_STORE=database

# Path to the certificate signing keypair file (outside the DB - see
# config/certificates.php and app/Services/CertificateSigningService.php).
# Leave commented to use the default storage/app/certificates/signing-key.json
# (an empty value would override that default with "").
# CERTIFICATE_SIGNING_KEY_PATH=
CERTIFICATE_SIGNING_KEY_ID=timberhub-cert-key-1

# Carbon account types (carbon_developer, carbon_buyer) are dormant at launch.
# Set true to re-open them on web + API registration.
SIGNUP_CARBON_ENABLED=false

# Reverse proxies whose X-Forwarded-For/Proto/Host/Port headers are trusted
# (App\Http\Middleware\TrustProxies). Comma-separated IPs/CIDRs, or * to trust
# any peer (only when PHP is unreachable except through the proxy). Without a
# correct value every visitor shares one throttle bucket and HSTS never fires.
TRUSTED_PROXIES=127.0.0.1,::1

# Session cookie only over HTTPS. MUST be true in production (launch:check).
SESSION_SECURE_COOKIE=false

# One-click demo logins on /login. MUST be false in production (launch:check
# also checks the Pennant `features` row — see App\Features\DemoLoginsEnabled).
DEMO_LOGINS_ENABLED=false

# Sanctum (mobile API tokens / SPA).
# SANCTUM_STATEFUL_DOMAINS=www.cameroontimberhub.com
SANCTUM_TOKEN_PREFIX=

# Bot protection on public forms (config/trust.php).
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional display FX rate for USD hints on XAF prices (config/timber.php).
TIMBER_FX_USD_PER_XAF=

# Marketplace commission plumbing (config/timber.php → commission). Rates and
# caps themselves live in /admin → Commission rules. The USD rates only convert
# a rule's USD-denominated cap (the §15 $5,000) into the order's currency.
COMMISSION_PROTECT_ALL_ORDERS=true
COMMISSION_USD_TO_XAF=600
COMMISSION_USD_TO_EUR=
COMMISSION_USD_TO_GBP=
COMMISSION_USD_TO_CNY=

# Mobile app download links (config/mobile.php).
MOBILE_APK_URL=
MOBILE_APK_VERSION=
MOBILE_APK_SIZE=
MOBILE_PLAY_STORE_URL=
MOBILE_APP_STORE_URL=

# ---------------------------------------------------------------------------
# Payment gateways (config/payments.php). Env values are the FALLBACK — live
# credentials are normally entered in /admin → Payment settings (encrypted,
# two-person controlled). Leave blank to keep a gateway disabled.
# Mobile-money callbacks are never trusted: the app re-queries the provider's
# status API before completing a payment.
# ---------------------------------------------------------------------------
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=mtncameroon
MTN_MOMO_CALLBACK_HOST=
MTN_MOMO_CURRENCY=XAF

ORANGE_MONEY_ENVIRONMENT=sandbox
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CURRENCY=XAF

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# AI provider API keys are NOT env values — they are stored encrypted in the
# ai_settings table via the two-person flow in /admin (config/ai.php).

# Staff 2FA enforcement (config/auth.php, default true; phpunit sets false)
# and contact-form inbox (config/contact.php). Both are live in this release;
# launch:check FAILS in production unless STAFF_REQUIRE_2FA is true.
# STAFF_REQUIRE_2FA=true
# CONTACT_INBOX=info@cameroontimberhub.com

# Offsite backup hook for deploy/backup.sh (optional).
# BACKUP_DIR=/home/timberhub/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_RCLONE_REMOTE=s3:timberhub-backups

# ===========================================================================
# PRODUCTION — copy into the server's .env and fill in. Then run
# `php artisan launch:check` (must exit 0). See docs/ops/RUNBOOK.md
# "Go-live checklist".
# ===========================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.cameroontimberhub.com
# APP_KEY=            # php artisan key:generate --show (ONCE; back it up)
# LOG_LEVEL=warning
# LOG_STACK=daily
# TRUSTED_PROXIES=127.0.0.1,::1      # or Cloudflare/LB CIDRs, or *
# SESSION_DRIVER=redis
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.cameroontimberhub.com
# QUEUE_CONNECTION=redis              # never sync
# CACHE_STORE=redis
# DEMO_LOGINS_ENABLED=false
# MAIL_MAILER=smtp                    # never log/array
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@cameroontimberhub.com   # domain with SPF/DKIM/DMARC
# MAIL_OPS_ADDRESS=ops@cameroontimberhub.com
# CERTIFICATE_SIGNING_KEY_PATH=/home/timberhub/secrets/signing-key.json
# STAFF_REQUIRE_2FA=true
# CONTACT_INBOX=info@cameroontimberhub.com
# TERMS_VERSION=2026-10
# API_REQUIRE_TERMS_ACCEPTED=false    # set true once all live app builds send terms_accepted
# RFQ_AUTO_APPROVE_LOW_RISK=true
# RFQ_AUTO_ROUTE_ON_APPROVAL=true
# RFQ_AUTO_ROUTE_MAX=30
# SIGNUP_CARBON_ENABLED=false         # keep false until carbon project review exists in /admin
