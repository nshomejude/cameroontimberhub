{
  "$meta": {
    "name": "Cameroon Timber Hub — Design Tokens",
    "description": "Source-of-truth design tokens for the public (forest/timber) experience. Mirrors resources/css/app.css @theme. The admin/exporter Filament panels use a separate Amber theme and are not covered here.",
    "rootFontSize": "118.75% (≈19px) — all rem values resolve against this base"
  },
  "color": {
    "forest": {
      "50": "#f1f7f2", "100": "#dcebe0", "200": "#bad7c2", "300": "#8fbb9d",
      "400": "#5d9a71", "500": "#3c7d52", "600": "#2c6240", "700": "#254f35",
      "800": "#20402c", "900": "#1b3425", "950": "#0e1c14"
    },
    "timber": {
      "50": "#faf6ef", "100": "#f3e7d2", "200": "#e6cca1", "300": "#d7ac6c",
      "400": "#cb9248", "500": "#bd7a32", "600": "#a3612a", "700": "#834b27",
      "800": "#6c3f25", "900": "#5a3622"
    },
    "sand": {
      "50": "#fbf9f4", "100": "#f5f0e6", "200": "#ebe3d2", "300": "#dcceb4", "400": "#c4b08a"
    },
    "ink": { "DEFAULT": "#201e18", "soft": "#5b554a" }
  },
  "font": {
    "display": "Fraunces, ui-serif, Georgia, 'Times New Roman', serif",
    "sans": "'Instrument Sans', ui-sans-serif, system-ui, sans-serif"
  },
  "fontSize": {
    "_note": "rem value + computed px at the 118.75% (19px) root",
    "xs":  { "rem": "0.75rem",  "px": 14.25 },
    "sm":  { "rem": "0.875rem", "px": 16.63 },
    "base":{ "rem": "1rem",     "px": 19.0 },
    "lg":  { "rem": "1.125rem", "px": 21.38 },
    "xl":  { "rem": "1.25rem",  "px": 23.75 },
    "2xl": { "rem": "1.5rem",   "px": 28.5 },
    "3xl": { "rem": "1.875rem", "px": 35.63 },
    "4xl": { "rem": "2.25rem",  "px": 42.75 },
    "5xl": { "rem": "3rem",     "px": 57.0 },
    "6xl": { "rem": "3.75rem",  "px": 71.25 },
    "7xl": { "rem": "4.5rem",   "px": 85.5 }
  },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "lineHeight": { "body": 1.7, "tight": 1.1, "heading": 1.03 },
  "letterSpacing": { "heading": "-0.01em", "eyebrow": "0.12em" },
  "radius": {
    "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "3xl": "1.5rem", "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "card": "0 1px 0 rgb(0 0 0 / 0.02)"
  },
  "breakpoint": {
    "_note": "Tailwind defaults; the native app shell switches from bottom tab bar to desktop nav rail at md (768px)",
    "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px"
  },
  "motion": {
    "easing": "cubic-bezier(0.32, 0.72, 0, 1)",
    "pageInForward": "pageInForward 0.26s cubic-bezier(0.32, 0.72, 0, 1)",
    "pageInBack": "pageInBack 0.26s cubic-bezier(0.32, 0.72, 0, 1)",
    "sheetUp": "sheetUp 0.3s cubic-bezier(0.32, 0.72, 0, 1)"
  },
  "app": {
    "themeColor": "#1b3425",
    "appBarMinHeight": "3.5rem",
    "tabBarColumns": 5,
    "safeArea": "env(safe-area-inset-*) honored on app bar (top) and tab bar (bottom)",
    "touchTarget": "44px minimum"
  },
  "eyebrow": {
    "fontSize": "0.75rem", "fontWeight": 600, "letterSpacing": "0.12em",
    "textTransform": "uppercase", "color": "#834b27"
  }
}
